{
  "name": "dsh-purge",
  "version": "2.0.0",
  "description": "DeepSeek Harness Web plugin: Cordis systemPrompt inject + slim redteam preset. No host disk patches.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./redteam": "./lib/redteam/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "presets",
    "skills",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown && node scripts/copy-defaults.mjs",
    "typecheck": "tsc --noEmit",
    "validate": "npm run build && node scripts/validate.mjs",
    "prepublishOnly": "npm run build"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/911218sky/dsh-purge.git"
  },
  "homepage": "https://github.com/911218sky/dsh-purge#readme",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    },
    "install": {
      "preferred": "tarball",
      "tarball": "https://github.com/911218sky/dsh-purge/archive/refs/heads/master.tar.gz",
      "zip": "https://github.com/911218sky/dsh-purge/archive/refs/heads/master.zip",
      "git": "https://github.com/911218sky/dsh-purge.git"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "@types/react": "~18.3.1",
    "react": "^18.2.0",
    "tsdown": "^0.22.2",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.1-0 <0.3.0"
  }
}
